# API keys. Which model each task uses is set in configs/models.yaml;
# you only need the keys for the providers your chosen models use.
# Leave a key empty if you don't use that provider.

# claude-* models (defaults: eval judge, DPO guideline translation, API rewrites)
ANTHROPIC_API_KEY=

# gpt-* / o* models (default: dataset annotation) and memory-search embeddings
OPENAI_API_KEY=

# Arena baselines (python run.py --step arena), served via OpenRouter; also
# used by any task whose base_url in configs/models.yaml points at OpenRouter
OPENROUTER_API_KEY=

# Required for training -- HuggingFace token for downloading base models
# Get yours at: https://huggingface.co/settings/tokens
# If a base model in configs/models.yaml is gated, accept its license on Hugging Face.
# Then create a Modal secret: modal secret create huggingface-secret HF_TOKEN=hf_yourtoken
HF_TOKEN=

# Optional one-off overrides of configs/models.yaml (uncomment to use):
# ANNOTATION_MODEL=gpt-5.5
# JUDGE_MODEL=claude-opus-4-6
# JUDGE_REASONING=medium
# JUDGE_BASE_URL=https://openrouter.ai/api/v1
# TRANSLATE_MODEL=claude-opus-4-6
# TRANSLATE_REASONING=medium
# Note: LLM-judge scores are judge-dependent and not comparable across judge models.
